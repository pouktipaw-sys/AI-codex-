FLOW_DATABASE_URL=sqlite:///./flowstate.db
FLOW_API_TOKEN=
FLOW_PROVIDER=local
FLOW_MODEL=
FLOW_PROVIDER_KEY=
FLOW_PROVIDER_URL=https://api.openai.com/v1
# Hosted mode only; keep all values server-side.
FLOW_ENVIRONMENT=local
FLOW_DEMO_PASSWORD=
# JSON array, e.g. ["your-domain.example"]; Render hostname is detected automatically.
FLOW_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
FLOW_FRONTEND_DIR=frontend/dist

# Free hosted demo: ephemeral storage; local AI only (no paid provider calls).
FLOW_FREE_HOSTING=false
FLOW_STORAGE_MODE=persistent
